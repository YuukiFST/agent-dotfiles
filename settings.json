{
  "permissions": {
    "deny": [
      "NotebookEdit",
      "DesignSync",
      "RemoteTrigger",
      "PushNotification",
      "mcp__visualize__show_widget",
      "mcp__visualize__read_me"
    ]
  },
  "disableWorkflows": true,
  "disableArtifact": true,
  "skillOverrides": {
    "dataviz": "off",
    "artifact-design": "off"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "rtk hook claude",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "grep -qE \"\\\"file_path\\\":\\\"[^\\\"]*\\.(tsx|jsx|css)\\\"\" && printf \"%s\" \"{\\\"hookSpecificOutput\\\":{\\\"hookEventName\\\":\\\"PreToolUse\\\",\\\"additionalContext\\\":\\\"Frontend file: ~/.claude/rules/frontend.md (multi-skill pipeline) is MANDATORY before UI code - unless the project defines its own Design System (then follow it exactly). Trivial fixes (~10 lines) exempt.\\\"}}\" || true",
            "shell": "bash",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "pwsh -NoProfile -ExecutionPolicy Bypass -File \"C:\\Users\\tisao\\.claude\\hooks\\caveman-statusline.ps1\""
  },
  "enabledPlugins": {
    "caveman@caveman": true,
    "superpowers@claude-plugins-official": true,
    "ponytail@ponytail": true
  },
  "extraKnownMarketplaces": {
    "caveman": {
      "source": {
        "source": "github",
        "repo": "JuliusBrussee/caveman"
      }
    },
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    }
  },
  "effortLevel": "high",
  "autoUpdatesChannel": "latest",
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "theme": "dark"
}
