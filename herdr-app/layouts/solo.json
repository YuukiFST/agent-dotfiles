{
  "id": "root",
  "type": "column",
  "titlebar": "none",
  "traffic_lights": [
    12,
    16
  ],
  "background": "canvas",
  "terminal_padding": [
    10,
    8
  ],
  "children": [
    {
      "id": "body",
      "type": "row",
      "children": [
        {
          "id": "sidebar",
          "type": "column",
          "children": [
            {
              "id": "brand",
              "type": "block",
              "content": {
                "mod": "workspace-chrome"
              },
              "size": {
                "px": 46
              },
              "window_drag": true
            },
            {
              "id": "sidebar-lists",
              "type": "column",
              "children": [
                {
                  "id": "spaces",
                  "type": "block",
                  "content": {
                    "mod": "spaces"
                  },
                  "size": {
                    "weight": 1
                  },
                  "min": 90
                },
                {
                  "id": "agents",
                  "type": "block",
                  "content": {
                    "mod": "agents"
                  },
                  "size": {
                    "weight": 1
                  },
                  "min": 90
                }
              ]
            }
          ],
          "size": {
            "px": 220
          },
          "min": 44,
          "max": 480,
          "background": "chrome",
          "resizable": false
        },
        {
          "id": "memory",
          "type": "block",
          "size": {
            "px": 340
          },
          "min": 260,
          "content": {
            "mod": "ai-memory",
            "props": {
              "block": "memory"
            }
          },
          "radius": 10,
          "border": {
            "width": 1,
            "color": "border"
          },
          "hidden": true,
          "max": 700
        },
        {
          "id": "work",
          "type": "column",
          "children": [
            {
              "id": "tabs",
              "type": "block",
              "content": {
                "mod": "tabs-graph"
              },
              "size": {
                "px": 42
              },
              "window_drag": true
            },
            {
              "id": "work-body",
              "type": "row",
              "children": [
                {
                  "id": "main",
                  "type": "block",
                  "content": {
                    "tab": "active",
                    "pane": {
                      "header": {
                        "content": {
                          "mod": "pane-info"
                        },
                        "reveal": "always",
                        "height": 30,
                        "position": "top"
                      },
                      "background": "background",
                      "border": {
                        "width": 1,
                        "color": "border"
                      },
                      "focus": {
                        "width": 1,
                        "color": "accent"
                      },
                      "radius": 10,
                      "gap": 8,
                      "lone": true
                    }
                  }
                },
                {
                  "id": "panel",
                  "type": "column",
                  "children": [
                    {
                      "id": "panel-body",
                      "type": "stack",
                      "children": [
                        {
                          "id": "files",
                          "type": "block",
                          "content": {
                            "mod": "files"
                          }
                        },
                        {
                          "id": "changes",
                          "type": "block",
                          "content": {
                            "mod": "changes"
                          }
                        }
                      ],
                      "active": "files"
                    }
                  ],
                  "size": {
                    "px": 368
                  },
                  "min": 280,
                  "max": 900,
                  "hidden": true
                }
              ],
              "padding": 6,
              "gap": 6
            }
          ],
          "resizable": false
        }
      ],
      "divider": {
        "width": 1,
        "color": "border"
      }
    },
    {
      "id": "footer",
      "type": "row",
      "children": [
        {
          "id": "status",
          "type": "block",
          "content": {
            "mod": "workspace-status"
          },
          "size": {
            "weight": 1
          }
        },
        {
          "id": "agent-watch",
          "type": "block",
          "content": {
            "mod": "agent-watch"
          },
          "size": {
            "px": 110
          }
        },
        {
          "id": "usage-bar",
          "type": "block",
          "size": {
            "px": 880
          },
          "content": {
            "mod": "claude-usage"
          }
        }
      ],
      "size": {
        "px": 28
      },
      "divider": {
        "width": 1,
        "color": "border"
      },
      "resizable": false
    }
  ],
  "terminal_menu": "menu-edited"
}
