{
  "id": "root",
  "cloned_from": {
    "name": "main",
    "version": "0.1.12"
  },
  "type": "row",
  "children": [
    {
      "id": "sidebar",
      "type": "column",
      "children": [
        {
          "id": "brand",
          "type": "block",
          "content": {
            "mod": "workspace-chrome"
          },
          "size": {
            "px": 46
          },
          "window_drag": true
        },
        {
          "id": "sidebar-lists",
          "type": "column",
          "children": [
            {
              "id": "spaces",
              "type": "block",
              "content": {
                "mod": "spaces-edited"
              },
              "size": {
                "weight": 1
              },
              "min": 90
            },
            {
              "id": "agents",
              "type": "block",
              "content": {
                "mod": "agents-edited",
                "props": {
                  "followFocus": true
                }
              },
              "size": {
                "weight": 1
              },
              "min": 90
            }
          ]
        }
      ],
      "size": {
        "px": 240
      },
      "min": 44,
      "max": 480,
      "background": "chrome",
      "resizable": false
    },
    {
      "id": "work",
      "type": "column",
      "children": [
        {
          "id": "tabs",
          "type": "block",
          "content": {
            "mod": "tabs-graph"
          },
          "size": {
            "px": 42
          },
          "window_drag": true
        },
        {
          "id": "work-view",
          "type": "stack",
          "children": [
            {
              "id": "main",
              "type": "block",
              "padding": 8,
              "content": {
                "tab": "active",
                "pane": {
                  "header": {
                    "content": {
                      "mod": "pane-info"
                    },
                    "reveal": "always",
                    "height": 30,
                    "position": "top"
                  },
                  "background": "background",
                  "border": {
                    "width": 1,
                    "color": "border"
                  },
                  "focus": {
                    "width": 1,
                    "color": "accent"
                  },
                  "radius": 10,
                  "gap": 8,
                  "lone": true
                }
              }
            },
            {
              "id": "side",
              "type": "row",
              "children": [],
              "padding": 8,
              "gap": 8
            }
          ],
          "active": "main",
          "size": {
            "weight": 1
          }
        },
        {
          "id": "footer",
          "type": "row",
          "children": [
            {
              "id": "status",
              "type": "block",
              "content": {
                "mod": "workspace-status"
              },
              "size": {
                "weight": 1
              }
            },
            {
              "id": "usage-bar",
              "type": "block",
              "size": {
                "px": 840
              },
              "content": {
                "mod": "claude-usage"
              }
            }
          ],
          "size": {
            "px": 28
          },
          "resizable": false
        },
        {
          "id": "timeline-recorder",
          "type": "block",
          "size": {
            "px": 0
          },
          "content": {
            "mod": "timeline",
            "props": {
              "record": true
            }
          }
        }
      ],
      "resizable": false
    }
  ],
  "background": "canvas",
  "terminal_padding": [
    10,
    8
  ],
  "divider": {
    "width": 1,
    "color": "border"
  },
  "titlebar": "none",
  "traffic_lights": [
    12,
    16
  ]
}