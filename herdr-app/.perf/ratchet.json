      "pick": "cpu_pct",
      "unit": "%",
      "better": "lower",
      "runs": 3,
      "tolerance": 0.25,
      "minDelta": 1
    },
    {
      "id": "sessions.working_private_mb",
      "command": "node .perf/measure/isolated.mjs --layout .perf/layouts/perf-sessions.json --working --settle 6 --seconds 12",
      "pick": "private_mb",
      "unit": "MB",
      "better": "lower",
      "runs": 3,
      "minDelta": 10
    },
    {
      "id": "startup.sessions_window_ms",
      "command": "node .perf/measure/isolated.mjs --layout .perf/layouts/perf-sessions.json --working --settle 6 --seconds 12",
      "pick": "window_ms",
      "unit": "ms",
      "better": "lower",
      "runs": 3,
      "tolerance": 0.15,
      "minDelta": 60
    },
    {
      "id": "treemap.glide_fps_median",
      "command": "node .perf/measure/treemap-glide.mjs --seconds 10",
      "pick": "fps_median",
      "unit": "fps",
      "better": "higher",
      "runs": 5,
      "tolerance": 0.1
