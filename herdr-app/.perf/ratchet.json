    {
      "id": "treemap.glide_fps_p5",
      "command": "node .perf/measure/treemap-glide.mjs --seconds 10",
      "pick": "fps_p5",
      "unit": "fps",
      "better": "higher",
      "runs": 5,
      "tolerance": 0.25
