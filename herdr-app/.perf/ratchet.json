    {
      "id": "treemap.glide_frame_ms_p95",
      "command": "node .perf/measure/treemap-glide.mjs --seconds 10",
      "pick": "frame_ms_p95",
      "unit": "ms",
      "better": "lower",
      "runs": 5,
      "tolerance": 0.25,
      "minDelta": 8
