            "required": ["requires", "grants"],
            "additionalProperties": false
          },
          "refutation_checklist": {
            "type": "array",
            "description": "One item per check, each exactly once. A status other than PASS needs a reason; a FAIL cites the file and line that refute the check. VALIDATION-AND-REPORTING.md defines the checks.",
            "minItems": 8,
            "uniqueItems": true,
            "items": {
              "type": "object",
              "properties": {
                "check": {
                  "type": "string",
                  "enum": ["lower_trust_principal", "reachable_entrypoint", "control_bypassed", "crosses_boundary", "decided_by_visible_facts", "result_not_overstated", "beyond_best_practice", "marginal_capability"]
                },
                "status": {
                  "type": "string",
                  "enum": ["PASS", "FAIL", "UNKNOWN", "NOT_APPLICABLE"]
