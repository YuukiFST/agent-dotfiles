{
  "$comment": "Top-level contract for findings.json. validate-findings.cjs interprets and checks this schema directly.",
  "type": "array",
  "items": {
    "oneOf": [
      {
        "type": "object",
        "description": "A source-grounded vulnerability that was independently demonstrated.",
        "properties": {
          "verdict": {
            "type": "string",
            "const": "confirmed"
          },
          "fingerprint": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+-]*$",
            "description": "A stable source-derived identifier that does not change between validation states."
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "visibleContent": true
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "visibleContent": true
          },
          "cwe": {
            "type": "string",
            "pattern": "^CWE-[1-9][0-9]*$",
            "description": "The MITRE CWE identifier the root cause maps to. Leave it out when no weakness fits rather than guessing; export-sarif.cjs tags the result with it."
          },
          "root_cause": {
            "type": "string",
            "minLength": 1,
            "visibleContent": true
          },
          "intended_behavior": {
            "type": "string",
            "minLength": 1,
            "visibleContent": true
          },
          "trace": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "enum": ["entrypoint", "propagation", "sink"]
                },
                "file": {
                  "type": "string",
                  "minLength": 1
                },
                "line": {
                  "type": "integer",
                  "minimum": 1
                },
                "scope": {
                  "type": "string",
                  "minLength": 1,
                  "visibleContent": true
                },
                "description": {
                  "type": "string",
                  "minLength": 1,
                  "visibleContent": true
                },
                "snippet_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$",
                  "description": "Optional. SHA-256 of the cited line with surrounding whitespace trimmed, as printed by validate-citations.cjs --print-hashes. Left off a line that holds a password, personal datum, or real host."
                }
              },
              "required": ["kind", "file", "line", "scope", "description"],
              "additionalProperties": false
            }
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "object",
              "properties": {
                "file": {
                  "type": "string",
                  "minLength": 1
                },
                "line": {
                  "type": "integer",
                  "minimum": 1
                },
                "description": {
                  "type": "string",
                  "minLength": 1,
                  "visibleContent": true
                },
                "snippet_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$",
                  "description": "Optional. SHA-256 of the cited line with surrounding whitespace trimmed, as printed by validate-citations.cjs --print-hashes. Left off a line that holds a password, personal datum, or real host."
                }
              },
              "required": ["file", "line", "description"],
              "additionalProperties": false
            }
          },
          "conditions": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "enum": ["authentication_level", "authorization_role", "user_interaction", "system_configuration", "network_routing", "environmental_dependency", "data_state", "timing_dependency", "third_party_dependency"]
                },
                "description": {
                  "type": "string",
                  "minLength": 1,
                  "visibleContent": true
                }
              },
              "required": ["kind", "description"],
              "additionalProperties": false
            }
          },
          "capabilities": {
            "type": "object",
            "description": "requires: what the attacker must already hold, with exactly one principal:* token. grants: what the demonstrated or claimed result adds. A token holds the weaker ones: each principal holds the principals before it in anonymous, authenticated_user (with its own data), tenant_admin, system_admin, trusted_controller (with config, code, and server execution), and local_user holds anonymous; a wider read or write holds the narrower one; exec:host_code holds exec:server_code; session:other_user holds authenticated_user and session:any_user holds system_admin. What grants adds beyond requires caps a confirmed overall_severity, and validate-findings.cjs enforces each cap: nothing added, medium (low for principal:trusted_controller); only the attacker's own data, medium; a tenant_admin or system_admin attacker that gains no higher principal, any-user session, secret, internal network, shared service, cross-tenant access, all-data read, code write, or code execution, medium. chain-findings.cjs joins one record's grants to another's requires.",
            "properties": {
              "requires": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "enum": ["principal:anonymous", "principal:authenticated_user", "principal:tenant_admin", "principal:system_admin", "principal:trusted_controller", "principal:local_user", "read:own_data", "read:other_user_data", "read:cross_tenant_data", "read:all_data", "read:secret", "read:internal_network", "write:own_data", "write:other_user_data", "write:cross_tenant_data", "write:config", "write:code", "exec:other_user_browser", "exec:server_code", "exec:host_code", "session:other_user", "session:any_user", "availability:shared_service"]
                }
              },
              "grants": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "enum": ["principal:anonymous", "principal:authenticated_user", "principal:tenant_admin", "principal:system_admin", "principal:trusted_controller", "principal:local_user", "read:own_data", "read:other_user_data", "read:cross_tenant_data", "read:all_data", "read:secret", "read:internal_network", "write:own_data", "write:other_user_data", "write:cross_tenant_data", "write:config", "write:code", "exec:other_user_browser", "exec:server_code", "exec:host_code", "session:other_user", "session:any_user", "availability:shared_service"]
                }
              }
            },
            "required": ["requires", "grants"],
            "additionalProperties": false
          },
          "refutation_checklist": {
            "type": "array",
            "description": "One item per check, each exactly once. A status other than PASS needs a reason; a FAIL cites the file and line that refute the check. NOT_APPLICABLE means an earlier check in list order is FAIL or UNKNOWN, or marks marginal_capability when grants adds nothing beyond requires; a confirmed record uses it only for that marginal case. VALIDATION-AND-REPORTING.md defines the checks.",
            "minItems": 8,
            "uniqueItems": true,
            "items": {
              "type": "object",
              "properties": {
                "check": {
                  "type": "string",
                  "enum": ["lower_trust_principal", "reachable_entrypoint", "control_bypassed", "crosses_boundary", "decided_by_visible_facts", "result_not_overstated", "beyond_best_practice", "marginal_capability"]
                },
                "status": {
                  "type": "string",
                  "enum": ["PASS", "FAIL", "UNKNOWN", "NOT_APPLICABLE"]
                },
                "reason": {
                  "type": "string",
                  "minLength": 1,
                  "visibleContent": true
                },
                "file": {
                  "type": "string",
                  "minLength": 1
                },
                "line": {
                  "type": "integer",
                  "minimum": 1
                },
                "snippet_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$",
                  "description": "Optional. SHA-256 of the cited line with surrounding whitespace trimmed, as printed by validate-citations.cjs --print-hashes. Left off a line that holds a password, personal datum, or real host."
                }
              },
              "required": ["check", "status"],
              "additionalProperties": false
            }
          },
          "execution": {
            "type": "object",
            "description": "Target-neutral reproduction in the target's native interface.",
            "properties": {
              "attacker_perspective": {
                "type": "string",
                "minLength": 1,
                "visibleContent": true
              },
              "payloads": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string"
                }
              },
              "instructions": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "visibleContent": true
                }
              },
              "observed_result": {
                "type": "string",
                "minLength": 1,
                "visibleContent": true
              },
              "evidence_kind": {
                "type": "string",
                "enum": ["source_observation", "local_differential", "local_state_readback", "local_artifact", "sanitizer_report", "rendered_policy"],
                "description": "What establishes observed_result. source_observation: the result is a fact of the repository itself, such as a committed credential, so no execution applies. local_differential: the attack input and the control input through the same boundary give different results. local_state_readback: dummy state read back after the action shows the change. local_artifact: the check reads back a unique marker that only the defect can produce. sanitizer_report: a sanitizer or runtime checker reports the fault. rendered_policy: a locally rendered or evaluated policy decides for the dummy attacker identity. Every kind but source_observation requires control."
              },
              "control": {
                "type": "object",
                "description": "The same check through the same boundary with a benign input or an authorized principal. Its observed_result must differ from the attack's, or the check could not have failed.",
                "properties": {
                  "input": {
                    "type": "string",
                    "minLength": 1,
                    "visibleContent": true
                  },
                  "observed_result": {
                    "type": "string",
                    "minLength": 1,
                    "visibleContent": true
                  }
                },
                "required": ["input", "observed_result"],
                "additionalProperties": false
              }
            },
            "required": ["attacker_perspective", "payloads", "instructions", "observed_result", "evidence_kind"],
            "additionalProperties": false
          },
          "counterevidence": {
            "type": "string",
            "minLength": 1,
            "visibleContent": true,
            "description": "The strongest case found against this finding and why it does not neutralize the result, or what was checked when nothing was found."
          },
          "remediation": {
            "type": "object",
            "properties": {
              "strategy": {
                "type": "string",
                "minLength": 1,
                "visibleContent": true
              },
              "code_changes": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "file_name": {
                      "type": "string",
                      "minLength": 1
                    },
                    "fixed_code": {
                      "type": "string"
                    }
                  },
                  "required": ["file_name", "fixed_code"],
                  "additionalProperties": false
                }
              },
              "invariant": {
                "type": "string",
                "minLength": 1,
                "visibleContent": true,
                "description": "The security property the fix enforces, in one sentence. Required with nonempty code_changes."
              },
              "verification": {
                "type": "array",
                "description": "One entry per fix gate, required with nonempty code_changes. PASS: the gate was executed or traced through the patched source and holds. REASONED: argued from source without execution. NOT_RUN: not checked, with the reason. A fix that fails a gate carries no code_changes.",
                "items": {
                  "type": "object",
                  "properties": {
                    "gate": {
                      "type": "string",
                      "enum": ["closure", "bypass_review", "preserved_behavior", "regression_case"]
                    },
                    "status": {
                      "type": "string",
                      "enum": ["PASS", "REASONED", "NOT_RUN"]
                    },
                    "detail": {
                      "type": "string",
                      "minLength": 1,
                      "visibleContent": true
                    }
                  },
                  "required": ["gate", "status", "detail"],
                  "additionalProperties": false
                }
              }
            },
            "required": ["strategy"],
            "additionalProperties": false
          },
          "severity": {
            "type": "object",
            "properties": {
              "likelihood": {
                "type": "object",
                "properties": {
                  "score": {
                    "type": "string",
                    "enum": ["informational", "low", "medium", "high", "critical"]
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1,
                    "visibleContent": true
                  }
                },
                "required": ["score", "reason"],
                "additionalProperties": false
              },
              "impact": {
                "type": "object",
                "properties": {
                  "score": {
                    "type": "string",
                    "enum": ["informational", "low", "medium", "high", "critical"]
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1,
                    "visibleContent": true
                  }
                },
                "required": ["score", "reason"],
                "additionalProperties": false
              },
              "overall_severity": {
                "type": "string",
                "enum": ["informational", "low", "medium", "high", "critical"]
              },
              "model_dependent": {
                "type": "boolean",
                "description": "true when the result depends on probabilistic model behavior; caps overall_severity at high."
              },
              "change_conditions": {
                "type": "string",
                "minLength": 1,
                "visibleContent": true,
                "description": "The concrete fact that would raise or lower overall_severity, such as a deployment exposure or a precondition."
              }
            },
            "required": ["likelihood", "impact", "overall_severity", "model_dependent", "change_conditions"],
            "additionalProperties": false
          },
          "confidence": {
            "type": "object",
            "properties": {
              "score": {
                "type": "string",
                "enum": ["low", "medium", "high"]
              },
              "reason": {
                "type": "string",
                "minLength": 1,
                "visibleContent": true
              }
            },
            "required": ["score", "reason"],
            "additionalProperties": false
          }
        },
        "required": ["verdict", "fingerprint", "title", "description", "root_cause", "intended_behavior", "trace", "evidence", "conditions", "capabilities", "refutation_checklist", "execution", "counterevidence", "remediation", "severity", "confidence"],
        "additionalProperties": false
      },
