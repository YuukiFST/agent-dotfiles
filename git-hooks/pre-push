#!/usr/bin/env bash
# Blocks push when commits contain forbidden AI attribution trailers.
# Cursor injects Co-authored-by after git commit; this hook is the real enforcement gate.
set -euo pipefail

HOOK_DIR="$(cd "$(dirname "$0")" && pwd)"
# shellcheck source=validate-commit-message.sh
source "$HOOK_DIR/validate-commit-message.sh"

zero="0000000000000000000000000000000000000000"
failed=0

# SC2034: local_ref/remote_ref are positional fields of git pre-push protocol (local_ref local_sha remote_ref remote_sha), intentionally unused
# shellcheck disable=SC2034
while read -r local_ref local_sha remote_ref remote_sha; do
  [ -n "${local_sha:-}" ] || continue

  if [ "$local_sha" = "$zero" ]; then
    continue
  fi

  # Só commits que nenhum remoto conhece: os de outras pessoas trazidos por merge,
  # ou que já estão num remoto que não se chama origin (upstream de um fork), não são
  # deste push e passariam a bloqueá-lo.
  range=("$local_sha" --not --remotes)
  # Um force-push pode trazer um remote_sha que não existe localmente; rev-list falharia
  # e o push passaria sem nenhuma checagem.
  if [ -n "${remote_sha:-}" ] && [ "$remote_sha" != "$zero" ] &&
     git cat-file -e "${remote_sha}^{commit}" 2>/dev/null; then
    range+=("$remote_sha")
  fi

  while read -r commit; do
    [ -n "$commit" ] || continue
    if ! validate_commit_object "$commit"; then
      failed=1
    fi
  done < <(git rev-list "${range[@]}" 2>/dev/null || true)
done

if [ "$failed" -ne 0 ]; then
  echo "ERRO: push bloqueado — limpe os commits com scripts/git-safe-commit.sh (commit-tree)." >&2
  exit 1
fi

exit 0
