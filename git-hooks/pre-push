#!/usr/bin/env bash
# Blocks push when commits contain forbidden AI attribution trailers.
# Cursor injects Co-authored-by after git commit; this hook is the real enforcement gate.
set -euo pipefail

HOOK_DIR="$(cd "$(dirname "$0")" && pwd)"
# shellcheck source=validate-commit-message.sh
source "$HOOK_DIR/validate-commit-message.sh"

zero="0000000000000000000000000000000000000000"
failed=0

while read -r local_ref local_sha remote_ref remote_sha; do
  [ -n "${local_sha:-}" ] || continue

  if [ "$local_sha" = "$zero" ]; then
    continue
  fi

  if [ "${remote_sha:-}" = "$zero" ] || [ -z "${remote_sha:-}" ]; then
    # Branch nova no remoto: sem `--not --remotes` o rev-list devolve a história
    # inteira e o hook culpa commits antigos que já estão em origin/main.
    range=("$local_sha" --not --remotes=origin)
  else
    range=("${remote_sha}..${local_sha}")
  fi

  while read -r commit; do
    [ -n "$commit" ] || continue
    if ! validate_commit_object "$commit"; then
      failed=1
    fi
  done < <(git rev-list "${range[@]}" 2>/dev/null || true)
done

if [ "$failed" -ne 0 ]; then
  echo "ERRO: push bloqueado — limpe os commits com scripts/git-safe-commit.sh (commit-tree)." >&2
  exit 1
fi

exit 0
